+def over_budget(expenses, budgets):
+    """Return [(month, category, spent, limit)] for each month a limit was exceeded."""
+    spent = {}
+    for e in expenses:
+        key = (e["date"].strftime("%Y-%m"), e["category"])
+        spent[key] = spent.get(key, Decimal(0)) + e["amount"]
+    return [
+        (month, cat, amount, budgets[cat])
+        for (month, cat), amount in sorted(spent.items())
+        if cat in budgets and amount > budgets[cat]
+    ]
+
+
+def cmd_budget(expenses, budgets):
+    overs = over_budget(expenses, budgets)
+    for month, cat, amount, limit in overs:
+        print(f"WARNING {month} {cat}: {format_money(amount)} spent, "
+              f"{format_money(amount - limit)} over the {format_money(limit)} budget")
+    if not overs:
+        print("All categories are within budget.")
+
+
