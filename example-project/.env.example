# Copy this file to a new file called .env (in this same folder), then replace
# each put-your-key-here with your own API key, using a text editor. Write the key with no
# quote marks around it (docker run --env-file would keep them as part of the key).
# Never commit .env: git ignores it, and it must stay that way.
ANTHROPIC_API_KEY=put-your-key-here
# Your Google AI Studio key, for the notes command (week 10). Use this name only: don't also
# set GOOGLE_API_KEY, because Google's library would use that one instead.
GEMINI_API_KEY=put-your-key-here
